{
  "_about": "Single source of truth for the deterministic rules. Read by resume_match/rules.py and inlined into web/index.html by scripts/build_web.py. Patterns are matched case-insensitively against one sentence at a time (except names in skills.case_sensitive). Use only regex syntax that Python re and JavaScript share: no named groups, no inline flags. '{US}' expands to the US pattern.",
  "US": "(?:u\\.?\\s?s\\.?(?:a\\.?)?|united\\s+states)",
  "sentence_split": "(?<=[a-z0-9)][.!?])\\s+|(?<=;)\\s+|\\n+|•|·",
  "negation": "\\b(?:not|no|never)\\s+(?:be\\s+)?(?:required|necessary|needed)",
  "citizenship": [
    "\\b{US}\\s+citizen(?:ship)?\\s+(?:is\\s+|are\\s+)?(?:required|mandatory|needed|a\\s+must)",
    "\\bmust\\s+(?:be|hold|have|possess)\\s+(?:a\\s+)?{US}\\s+citizen",
    "\\brequires?\\s+{US}\\s+citizenship",
    "\\b(?:only\\s+{US}\\s+citizens|{US}\\s+citizens?\\s+only)",
    "\\b{US}\\s+citizens?\\s+(?:or|and/or|/)\\s+(?:lawful\\s+)?(?:permanent\\s+residents?|green\\s*card)",
    "\\bcitizenship\\s+(?:is\\s+)?required",
    "\\bmust\\s+be\\s+(?:a\\s+)?(?:citizen|permanent\\s+resident|green\\s*card\\s+holder)",
    "\\bpermanent\\s+(?:\\w+\\s+){0,2}work\\s+authori[sz]ation",
    "\\bauthori[sz]ed\\s+to\\s+work\\b.{0,60}\\bpermanent(?:ly|\\s+basis)?\\b",
    "\\b(?:green\\s*card|permanent\\s+residents?)\\s+(?:holders?\\s+)?(?:only|required)",
    "\\b(?:active|current|existing|obtain|maintain|eligib\\w*\\s+(?:to|for))\\s+(?:an?\\s+)?(?:\\w+\\s+){0,2}security\\s+clearance",
    "\\bsecurity\\s+clearance\\s+(?:is\\s+)?required",
    "\\b(?:ts/sci|top\\s+secret(?:\\s+clearance)?|secret\\s+clearance)\\b",
    "\\bitar\\b",
    "\\b{US}\\s+persons?\\b.(0, 40)\\b(?:itar|ear|export|22\\s*cfr|required)",
    "\\bexport\\s+control\\w*\\b.{0,80}\\b(?:citizen|u\\.?s\\.?\\s+person)",
    "\\bmust\\s+be\\s+(?:a\\s+)?{US}\\s+persons?\\b",
    "\\b{US}\\s+person\\s+status\\b"
  ],
  "no_sponsorship": [
    "\\b(?:unable|not\\s+able|cannot|can't|can\\s+not|will\\s+not|won't|does\\s+not|do\\s+not|doesn't|don't|not\\s+in\\s+a\\s+position)\\s+(?:to\\s+)?(?:\\w+\\s+){0,3}sponsor",
    "\\bno\\s+(?:\\w+\\s+)?(?:visa\\s+|immigration\\s+)?sponsorship",
    "\\bsponsorship\\s+(?:is\\s+|will\\s+)?(?:not|n't)\\b",
    "\\bsponsorship\\s+(?:is\\s+)?unavailable",
    "\\bwithout\\s+(?:the\\s+)?(?:need\\s+for\\s+|requiring\\s+|requirement\\s+of\\s+)?(?:current\\s+or\\s+future\\s+|future\\s+)?(?:\\w+\\s+){0,2}sponsorship(?!\\s+for\\s+an?\\s+export)",
    "\\bnot\\s+(?:be\\s+)?eligible\\s+for\\s+(?:\\w+\\s+)?sponsorship",
    "\\b(?:opt|cpt|f-?1|stem\\s+opt)\\b.{0,50}\\b(?:not\\s+(?:eligible|accepted|considered|supported)|ineligible)",
    "\\bnot\\s+be\\s+able\\s+to\\s+employ\\b",
    "\\bor\\s+support\\s+(?:future\\s+)?(?:h-?1-?b\\s+)?(?:visa\\s+)?sponsorship\\s+at\\s+this\\s+time"
  ],
  "h1b": [
    "\\bh-?1-?b\\b.{0,40}\\b(?:sponsor|available|offered|support|transfer)",
    "\\b(?:visa|immigration)\\s+sponsorship\\s+(?:is\\s+|may\\s+be\\s+)?(?:available|offered|provided|possible)",
    "\\b(?:will|can|does|do|may|able\\s+to)\\s+(?:also\\s+)?sponsor",
    "\\bsponsorship\\s+(?:is\\s+|may\\s+be\\s+)?available",
    "\\bopen\\s+to\\s+sponsor",
    "\\b(?:offer|provide)s?\\s+(?:\\w+\\s+)?(?:visa\\s+|immigration\\s+)?sponsorship"
  ],
  "opt_cpt": [
    "\\b(?:stem\\s+)?opt\\b(?![\\s-]+(?:out|in)\\b)",
    "\\bcpt\\b",
    "\\bf-?1\\b",
    "\\binternational\\s+students?\\b",
    "\\bcurricular\\s+practical\\s+training\\b",
    "\\boptional\\s+practical\\s+training\\b"
  ],
  "graduation": {
    "date": "\\b(?:(jan|feb|mar|apr|may|jun|jul|aug|sep|sept|oct|nov|dec)[a-z]*\\.?,?\\s+|(spring|summer|fall|autumn|winter)\\s+)?(?:of\\s+)?(20[2-3]\\d)\\b",
    "context": "graduat|class\\s+of|degree\\s+(?:completion|conferral)|complet\\w*\\s+(?:your|their|a|the)?\\s*degree|expected\\s+(?:to\\s+)?(?:graduat|complet)|enrolled|pursuing|returning\\s+to\\s+school|remaining\\s+after",
    "still_enrolled": "returning\\s+to\\s+school|remaining\\s+after|at\\s+least\\s+one\\s+(?:more\\s+)?(?:semester|quarter|term)",
    "range": "between|from|\\bto\\b|through|-|–",
    "by": "\\b(?:by|before|no\\s+later\\s+than|prior\\s+to)\\b",
    "after": "\\b(?:after|or\\s+later|no\\s+earlier\\s+than)\\b",
    "class_of": "\\bclass\\s+of\\b",
    "season_month": {
      "spring": 5,
      "summer": 8,
      "fall": 12,
      "autumn": 12,
      "winter": 12
    },
    "single_date_tolerance_months": 3,
    "not_a_requirement": "\\bsince\\s+20\\d\\d\\b|\\bhas\\s+graduated\\b|\\bhave\\s+graduated\\s+(?:more|over)\\b",
    "_continuation": "A graduation sentence with no date is joined with the next line when that line is short and holds a date (\"On track to graduate by\" / \"June 2029\").",
    "continuation_max_chars": 40
  },
  "difficulty": {
    "_why": "Fallback only (Claude gives its own difficulty). Not calibrated yet: run evals/ with a labelled set to tune. Each number is how many 0-100 points the signal adds.",
    "base": 35,
    "per_year_experience": 8,
    "max_years_counted": 15,
    "years_pattern": "(\\d{1,2})\\s*\\+?\\s*(?:-\\s*\\d{1,2}\\s*)?(?:years?|yrs?)\\b",
    "phd_required": {
      "pattern": "ph\\.?\\s?d[^.]{0,60}\\b(?:required|must)|\\b(?:required|must)[^.]{0,60}ph\\.?\\s?d",
      "points": 20
    },
    "phd_mentioned": {
      "pattern": "\\bph\\.?\\s?d\\b",
      "points": 8
    },
    "senior_title": {
      "pattern": "\\b(?:senior|sr\\.?|staff|lead|principal|manager)\\b",
      "points": 15
    },
    "entry_title": {
      "pattern": "\\b(?:intern(?:ship)?|co-?op|new\\s+grad|entry[\\s-]level|early\\s+career)\\b",
      "points": -10
    },
    "title_window_chars": 300
  },
  "skills": {
    "sde": {
      "C++": "\\bc\\+\\+",
      "C#": "\\bc#",
      "Java": "\\bjava\\b(?!\\s*script)",
      "Go/Golang": "\\bgolang\\b",
      "Rust": "\\brust\\b",
      "Kotlin": "\\bkotlin\\b",
      "Swift/iOS": "\\bswift\\b|\\bios\\s+develop",
      "Android": "\\bandroid\\b",
      "React": "\\breact(?:\\.js)?\\b",
      "Angular": "\\bangular\\b",
      "Vue": "\\bvue(?:\\.js)?\\b",
      "Node.js": "\\bnode(?:\\.js)?\\b",
      "TypeScript": "\\btypescript\\b",
      "JavaScript": "\\bjavascript\\b",
      "Frontend": "\\bfront[\\s-]?end\\b",
      "Backend": "\\bback[\\s-]?end\\b",
      "Full-stack": "\\bfull[\\s-]?stack\\b",
      "Microservices": "\\bmicroservices?\\b",
      "Distributed systems": "\\bdistributed\\s+systems?\\b",
      "System design": "\\bsystem\\s+design\\b",
      "Kubernetes": "\\bkubernetes\\b|\\bk8s\\b",
      "Embedded/firmware": "\\bembedded\\b|\\bfirmware\\b|\\brtos\\b",
      "Verilog/FPGA": "\\bverilog\\b|\\bvhdl\\b|\\bfpga\\b",
      "Low-latency": "\\blow[\\s-]latency\\b",
      "Compilers/OS": "\\bcompilers?\\b|\\boperating\\s+systems?\\b|\\blinux\\s+kernel\\b",
      "DS&A / LeetCode": "\\bdata\\s+structures\\s+(?:and|&)\\s+algorithms\\b",
      "Software engineering": "\\bsoftware\\s+(?:engineering|development)\\s+(?:experience|skills|best\\s+practices)"
    },
    "ds": {
      "Python": "\\bpython\\b",
      "R": "(?<![\\w-])R(?![\\w-])",
      "SQL": "\\bsql\\b",
      "Pandas": "\\bpandas\\b",
      "NumPy": "\\bnumpy\\b",
      "scikit-learn": "\\bscikit|\\bsklearn\\b",
      "Machine learning": "\\bmachine\\s+learning\\b|\\bml\\b",
      "Deep learning": "\\bdeep\\s+learning\\b|\\bneural\\s+net",
      "PyTorch": "\\bpytorch\\b",
      "TensorFlow": "\\btensorflow\\b",
      "Statistics": "\\bstatistic",
      "Regression": "\\bregression\\b",
      "A/B testing": "\\ba/b\\s+test|\\bexperimentation\\b",
      "Hypothesis testing": "\\bhypothesis\\s+test",
      "Causal inference": "\\bcausal\\b",
      "Time series / forecasting": "\\btime[\\s-]series\\b|\\bforecast",
      "NLP": "\\bnlp\\b|\\bnatural\\s+language",
      "LLM / GenAI": "\\bllms?\\b|\\bgenerative\\s+ai\\b|\\bgenai\\b",
      "Tableau": "\\btableau\\b",
      "Power BI": "\\bpower\\s?bi\\b",
      "Looker": "\\blooker\\b",
      "Excel": "\\bexcel\\b",
      "Spark": "\\bspark\\b|\\bpyspark\\b",
      "Airflow": "\\bairflow\\b",
      "dbt": "\\bdbt\\b",
      "Snowflake": "\\bsnowflake\\b",
      "BigQuery": "\\bbigquery\\b",
      "Databricks": "\\bdatabricks\\b",
      "AWS": "\\baws\\b",
      "GCP": "\\bgcp\\b|\\bgoogle\\s+cloud\\b",
      "Azure": "\\bazure\\b",
      "ETL": "\\betl\\b|\\belt\\b",
      "Data visualization": "\\bdata\\s+visuali[sz]ation\\b",
      "Dashboards": "\\bdashboards?\\b",
      "Operations research": "\\boperations\\s+research\\b|\\blinear\\s+programming\\b|\\bmixed[\\s-]integer\\b",
      "SAS": "\\bsas\\b",
      "MATLAB": "\\bmatlab\\b",
      "Git": "\\bgit\\b"
    },
    "domains": {
      "Finance": "\\bfinanc",
      "Accounting": "\\baccounting\\b",
      "Marketing": "\\bmarketing\\b",
      "Risk": "\\brisk\\b",
      "Credit": "\\bcredit\\b",
      "Fraud": "\\bfraud\\b",
      "Probability": "\\bprobabilit",
      "Stochastic": "\\bstochastic\\b",
      "Actuarial / insurance": "\\bactuar|\\binsurance\\b",
      "Pricing": "\\bpricing\\b",
      "Supply chain": "\\bsupply\\s+chain\\b",
      "Logistics": "\\blogistic(?:s|al)\\b",
      "Operations": "\\boperations\\b(?!\\s+research)",
      "Ads": "\\badvertis",
      "Healthcare": "\\bhealthcare\\b|\\bclinical\\b",
      "Econometrics": "\\beconometric",
      "Product analytics": "\\bproduct\\s+analytics\\b",
      "CRM": "\\bcrm\\b"
    },
    "case_sensitive": [
      "R"
    ],
    "no_tools_score": 50,
    "sde_penalty_each": 10,
    "sde_block_min": 3,
    "pass_score": 60,
    "warn_score": 40
  },
  "ranking": {
    "_why": "priority = fit - difficulty_weight * difficulty. 0.4 means a job 25 points harder needs 10 more fit points to rank level: fit is weighted more because a strong match still has a real shot at a hard team. Users can change it in the app; tune it against evals/ labels.",
    "difficulty_weight": 0.4
  },
  "decision": {
    "_why": "APPLY needs fit >= the user's apply threshold (default 65, set in the app). Within maybe_band points below it the verdict is MAYBE rather than SKIP, so near-misses get a human look.",
    "maybe_band": 15
  }
}
